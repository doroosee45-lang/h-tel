# --- Serveur ---
NODE_ENV=development
PORT=5000
# Origines autorisées (web), séparées par des virgules. Le mobile n'est pas concerné par CORS.
CLIENT_URL=http://localhost:5173

# --- Base de données ---
MONGO_URI=mongodb://127.0.0.1:27017/smart_hotel
HOTEL_ID=hotel_main

# --- JWT (générer des valeurs longues et aléatoires) ---
JWT_SECRET=change_me_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_me_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Cloudinary (upload d'images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paiements ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
MOBILE_MONEY_API_URL=
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_MERCHANT_ID=

# --- Assistant IA / chatbot ---
ANTHROPIC_API_KEY=
CHATBOT_ENABLED=true
CHATBOT_MODEL=

# --- Serrures connectées ---
LOCK_GATEWAY_API_URL=
LOCK_GATEWAY_API_KEY=
LOCK_GATEWAY_SECRET=change_me
